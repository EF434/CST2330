# Create the function to create isoline
isoline <- function (c, d, z){
  a <- z / d
  b <- -c / d
  return(function(x) a+b*x)
}

# Plot the line
plot(isoline(1, 3, 2000), xlim=c(0, 1000),ylim=c(0, 700),col ="blue")

# Highlight the feasible region
polygon(
  x = c(100, 100, 875, 1000),
  y = c(0, 1900/3, 375, 0),
  col = "pink"
)

# Ploting the constraint lines and isoprofit line
